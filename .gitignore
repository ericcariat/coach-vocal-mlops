# Python
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Données : JAMAIS dans git — versionnées par DVC.
# On ignore le CONTENU (`data/**`) et non le dossier : git ne peut pas
# désexclure un fichier situé sous un dossier lui-même exclu, or les pointeurs
# `*.dvc`, eux, doivent être versionnés.
data/**
!data/**/
!data/**/*.dvc
!data/**/.gitignore

# Artefacts d'expériences : modèles et figures lourds hors git.
# Les métriques/config/rapports des runs officiels sont versionnés (cf. .gitignore ci-dessous).
artifacts/mlruns/
artifacts/runs/**/model.keras
artifacts/runs/**/candidates/
artifacts/cache/
artifacts/reports/**/*.wav

# Audio brut (garde-fou : aucun média ne doit atterrir dans git)
*.wav
*.mp3
*.m4a
*.flac
*.ogg

# OS / IDE
.DS_Store
.idea/
.vscode/
exports/
